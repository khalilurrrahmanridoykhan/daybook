# ─────────────────────────────────────────────────────────────
# Daybook environment variables. Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Local:  postgresql://<you>@localhost:5432/daybook_dev?schema=public
# Neon:   postgresql://<user>:<pass>@<host>/<db>?sslmode=require
DATABASE_URL=
# Only needed for `prisma migrate` against a DB where the app user cannot create databases (e.g. Neon).
# On Neon, create a second branch/database and point this at it.
SHADOW_DATABASE_URL=

# ── Auth.js v5 ──────────────────────────────────────────────
# Generate: `openssl rand -base64 32`  (or `npx auth secret`)
AUTH_SECRET=
# Base URL of the app. Optional in dev; required in production.
AUTH_URL=http://localhost:3000

# ── Token vault ─────────────────────────────────────────────
# AES-256-GCM key for encrypting Google OAuth tokens at rest.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEY=

# ── Cron ────────────────────────────────────────────────────
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate: `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`
CRON_SECRET=

# ── Public ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google OAuth (Phase 1 social login · Phase 4 Calendar) ──
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.events

# ── Email — Resend (Phase 1) ────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Daybook <onboarding@resend.dev>

# ── Rate limiting — Upstash Redis (Phase 5) ─────────────────
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web push (Phase 4/5) ────────────────────────────────────
# Generate: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Error monitoring — Sentry (Phase 5) ─────────────────────
SENTRY_DSN=
